class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None

def height(root):
    if root is None:
        return 0

    return 1 + max(height(root.left), height(root.right))

root = Node(40)
root.left = Node(20)
root.right = Node(60)
root.left.left = Node(10)
root.left.right = Node(30)
root.right.left = Node(50)
root.right.right = Node(70)

print("Height of BST:", height(root))